{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luna",
  "scopeName": "source.luna",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#class-definitions" },
    { "include": "#function-definitions" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtin-classes" },
    { "include": "#builtin-functions" },
    { "include": "#member-access" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.luna",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.luna",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.luna",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.luna",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "class-definitions": {
      "patterns": [
        {
          "match": "\\b(class)\\s+([A-Z][A-Za-z0-9_]*)(?:\\s*(<)\\s*([A-Z][A-Za-z0-9_]*))?\\s*(:)",
          "captures": {
            "1": { "name": "storage.type.class.luna" },
            "2": { "name": "entity.name.type.class.luna" },
            "3": { "name": "keyword.operator.inheritance.luna" },
            "4": { "name": "entity.other.inherited-class.luna" },
            "5": { "name": "punctuation.section.block.begin.luna" }
          }
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([a-zA-Z_][A-Za-z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "storage.type.function.luna" },
            "2": { "name": "entity.name.function.luna" },
            "3": { "name": "punctuation.definition.parameters.begin.luna" }
          }
        },
        {
          "match": "^(\\s*)([a-zA-Z_][A-Za-z0-9_]*)\\s*(\\()(?=.*:\\s*$)",
          "captures": {
            "2": { "name": "entity.name.function.method.luna" },
            "3": { "name": "punctuation.definition.parameters.begin.luna" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.luna",
          "match": "\\b(if|else|while|for|return|break|continue|in|try|except)\\b"
        },
        {
          "name": "storage.type.luna",
          "match": "\\b(class|fun|lam)\\b"
        },
        {
          "name": "keyword.operator.logical.luna",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.other.luna",
          "match": "\\b(print)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.luna",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.luna",
          "match": "\\bnil\\b"
        },
        {
          "name": "variable.language.luna",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "builtin-classes": {
      "patterns": [
        {
          "name": "support.class.builtin.luna",
          "match": "\\b(Clip|Image|Text|Solid|Adjustment|Group|Precomp|Timeline|Project|ClipInstance|AnimatedProperty|Tint|Fill|BrightnessContrast|Blur|Mosaic|Grid|GradientRamp|FractalNoise|DisplacementMap|Posterize|SliderControl|AngleControl|CheckboxControl|PointControl|ColorControl|List|Dict|String)\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.luna",
          "match": "\\b(print|len|push|pop|get|set|clear|range|addUserPreset)\\b(?=\\s*\\()"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(\\.)(keyframes|add|set|withPreset|remove|clear|count|time|value|type|weight|shift|scaleTimes|copyFrom|setSource|getSourceClipId|linkNumber|linkColor|unlinkNumber|unlinkColor|setTimeline|preview|setPreviewRange|clearPreviewRange|getDuration|getTimeline|addEffect|getEffect|getEffectCount|removeEffect|clearEffects|setStart|getStart|setDuration|getDuration|setInPoint|getInPoint|setZIndex|getZIndex|setVisible|isVisible|moveToTrack|duplicate|remove)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.luna" },
            "2": { "name": "support.function.method.luna" }
          }
        },
        {
          "match": "(\\.)([a-zA-Z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.luna" },
            "2": { "name": "variable.other.property.luna" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.luna" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.luna",
          "match": "==|!=|<=|>=|<|>|=|\\+|-|\\*|/|!"
        },
        {
          "name": "punctuation.separator.key-value.luna",
          "match": ":"
        },
        {
          "name": "punctuation.separator.arguments.luna",
          "match": ","
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.keyword-argument.luna",
          "match": "\\b([a-zA-Z_][A-Za-z0-9_]*)(?=\\s*=)"
        },
        {
          "name": "variable.luna",
          "match": "\\b[a-zA-Z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
