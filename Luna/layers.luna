var proj = Project(640, 360, 24)
var tl = Timeline(640, 360, 24)
proj.setTimeline(tl)

var bg = Solid(640, 360, 18, 22, 28, 255)
bg.setOpacity(1)
var logo = Image("tests/assets/test_image.ppm")
logo.setScale(80)
logo.setPos(120, 80)
var title = Text("Layers")
title.setPos(220, 120)

var bgInst = tl.add(0, bg, 0)
bgInst.setDuration(3)
bgInst.setZIndex(-10)

var logoInst = tl.add(1, logo, 0)
logoInst.setDuration(3)
logoInst.addKeyframe("rotation", 0, 0, "linear")
logoInst.addKeyframe("rotation", 2, 180, "linear")
var tint = Tint(amount=0.85, color=[255, 140, 60, 255])
logoInst.addEffect(tint)
tint.setNumber("amount", 0.85)
tint.setColor("color", 255, 140, 60, 255)
var fill = Fill(amount=0.25, color=[30, 120, 255, 255])
logoInst.addEffect(fill)
fill.setNumber("amount", 0.25)
fill.setColor("color", 30, 120, 255, 255)
var mosaic = Mosaic(blockSize=4)
logoInst.addEffect(mosaic)
mosaic.setNumber("blockSize", 4)
mosaic.addNumberKeyframe("blockSize", 0, 4, "linear")
mosaic.setNumberKeyframe("blockSize", 2, 12, "linear")
var grid = Grid(sizeX=8, sizeY=8, lineWidth=0.08, opacity=0.5, color=[255, 255, 255, 255])
logoInst.addEffect(grid)
grid.setNumber("sizeX", 8)
grid.setNumber("sizeY", 8)
grid.setNumber("lineWidth", 0.08)
grid.setNumber("opacity", 0.5)
grid.setColor("color", 255, 255, 255, 255)
grid.addNumberKeyframe("opacity", 0, 0.2, "linear")
grid.setNumberKeyframe("opacity", 2, 0.8, "linear")
var ramp = GradientRamp(startX=0, startY=0, endX=1, endY=1, blend=0.5, startColor=[255, 0, 0, 255], endColor=[255, 255, 0, 255])
logoInst.addEffect(ramp)
ramp.setNumber("startX", 0)
ramp.setNumber("startY", 0)
ramp.setNumber("endX", 1)
ramp.setNumber("endY", 1)
ramp.setNumber("blend", 0.5)
ramp.setColor("startColor", 255, 0, 0, 255)
ramp.setColor("endColor", 255, 255, 0, 255)
ramp.addColorKeyframe("startColor", 0, 255, 0, 0, 255, "linear")
ramp.setColorKeyframe("startColor", 1, 0, 255, 0, 255, "linear")
ramp.setColorKeyframe("startColor", 2, 0, 0, 255, 255, "linear")
ramp.addColorKeyframe("endColor", 0, 255, 255, 0, 255, "linear")
ramp.setColorKeyframe("endColor", 1, 255, 0, 255, 255, "linear")
ramp.setColorKeyframe("endColor", 2, 0, 255, 255, 255, "linear")

var titleInst = tl.add(2, title, 0.5)
titleInst.setDuration(2.5)
titleInst.addKeyframe("opacity", 0, 0, "linear")
titleInst.addKeyframe("opacity", 0.5, 1, "linear")
var blur = Blur(radius=2)
titleInst.addEffect(blur)
blur.setNumber("radius", 2)

print tl.getDuration()
proj.preview(0, tl.getDuration())
