var p = Project(1280, 720, 30)
var tl = Timeline(1280, 720, 30)

var t = Text("Hello Luna!")
t.setFont("arial.ttf")
t.setSize(72)
t.setColor(255, 255, 255)          # 填充白色
t.setLetterSpacing(8.0)            # 新增：字符间距
t.setStroke(true, 4.0, 255, 255, 0)   # 新增：黑色描边，宽度 4

tl.add(0, t, 0.0)                  # 添加到时间线
p.setTimeline(tl)
p.preview(0, 5)                    # 预览 5 秒