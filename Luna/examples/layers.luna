proj = Project(640, 360, 24)
tl = Timeline(640, 360, 24)
proj.setTimeline(tl)

bg = Solid(640, 360, 18, 22, 28, 255)
logo = Image("tests/assets/test_image.ppm")
    .setScale(80)
    .setPos(120, 80)
title = Text("Layers")
    .setPos(220, 120)

bgInst = tl.add(0, bg, 0)
    .setDuration(3)
    .setZIndex(-10)

logoInst = tl.add(1, logo, 0)
    .setDuration(3)
logoInst.rotation.keyframes([
    [0, 0],
    [2, 180]
])
mosaic = logoInst.addEffect(
    Mosaic(
        blockSize=4
    )
)
mosaic.blockSize.keyframes([
    [0, 4],
    [2, 12]
])
logoInst.addEffect(
    Tint(
        amount=0.85,
        color=[255, 140, 60, 255]
    )
)
logoInst.addEffect(
    Fill(
        amount=0.25,
        color=[30, 120, 255, 255]
    )
)
grid = logoInst.addEffect(
    Grid(
        sizeX=8,
        sizeY=8,
        lineWidth=0.08,
        opacity=0.5,
        color=[255, 255, 255, 255]
    )
)
grid.opacity.keyframes([
    [0, 0.2],
    [2, 0.8]
])
ramp = logoInst.addEffect(
    GradientRamp(
        startX=0,
        startY=0,
        endX=1,
        endY=1,
        blend=0.5,
        startColor=[255, 0, 0, 255],
        endColor=[255, 255, 0, 255]
    )
)
ramp.startColor.keyframes([
    [0, [255, 0, 0, 255]],
    [1, [0, 255, 0, 255]],
    [2, [0, 0, 255, 255]]
])
ramp.endColor.keyframes([
    [0, [255, 255, 0, 255]],
    [1, [255, 0, 255, 255]],
    [2, [0, 255, 255, 255]]
])

titleInst = tl.add(2, title, 0.5)
    .setDuration(2.5)
titleInst.opacity.keyframes([
    [0, 0],
    [0.5, 1]
])
titleInst.addEffect(
    Blur(
        radius=2
    )
)

print tl.getDuration()
proj.preview(0, tl.getDuration())
