# error.luna

# 添加自定义预设
addUserPreset("smooth_spin", "bezier", 0.5)

# 1. 初始化
var proj = Project(960, 540, 30)
var tl = Timeline(960, 540, 30)
proj.setTimeline(tl)

# 2. 背景视频
print "Loading Video..."
var video = Clip("test.mp4")
var videoInst = nil
if video != nil:
    video.trim(0, 10)
    videoInst = tl.add(0, video, 0)
    print videoInst
    # 测试: volume, x, opacity
    videoInst.addKeyframe("volume", 0, 1.0, "linear")
    videoInst.addKeyframeWithPreset("volume", 5, 0.2, "ease_out")
    videoInst.addKeyframe("x", 0, 0, "hold")
    videoInst.addKeyframe("x", 8, 300, "bezier", 0.4)
    videoInst.addKeyframe("opacity", 0, 0.0, "linear")
    videoInst.addKeyframeWithPreset("opacity", 3, 1.0, "ease_in")
else:
    print "Video loading failed."

# 3. 文字图层
print "Creating Text Layer..."
var textLayer = Text("Keyframe Test")
var textInst = nil
if textLayer != nil:
    textLayer.setFont("arial.ttf")
    textLayer.setSize(50)
    textLayer.setColor(0, 255, 0)
    textLayer.trim(0, 10)
    textInst = tl.add(1, textLayer, 2)
    print textInst
    # 测试: font_size, rotation, y, scale_y
    textInst.addKeyframe("font_size", 0, 50, "hold")
    textInst.addKeyframe("font_size", 6, 100, "linear")
    textInst.addKeyframe("rotation", 0, 0, "bezier", 0.6)
    textInst.addKeyframeWithPreset("rotation", 7, 720, "smooth_spin")
    textInst.addKeyframe("y", 0, 100, "linear")
    textInst.addKeyframe("y", 5, 400, "ease_in_out")
    textInst.addKeyframe("scale_y", 0, 1.0, "hold")
    textInst.addKeyframe("scale_y", 4, 2.0, "bezier", 0.3)
else:
    print "Text layer failed."

print "Timeline Duration: "
print tl.duration
proj.preview(0, 10)